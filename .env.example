# Nebius Token Factory  (https://tokenfactory.nebius.com -> API keys)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily  (https://app.tavily.com)
TAVILY_API_KEY=

# Nemotron routing. Run `python -m ghostbusted.models` to print the exact IDs on your account.
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional
# GB_DEMO=1            # force demo mode (canned data, no keys needed)
# GB_DB_PATH=/data/ghostbusted.db
# GB_FOLLOWUP_DAYS=7
